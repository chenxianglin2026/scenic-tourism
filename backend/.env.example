# 景区智慧管理系统 - 环境变量配置
APP_NAME=景区智慧管理系统
APP_VERSION=0.1.0

# 开发模式: True=SQLite, False=PostgreSQL
DEV_MODE=True

# 数据库 (生产环境)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/scenic

# JWT
SECRET_KEY=scenic-jwt-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (小程序 + 管理后台)
CORS_ORIGINS=["*"]

# 微信小程序
WX_APPID=your_appid
WX_SECRET=your_secret

# 服务器域名
SERVER_DOMAIN=http://localhost:8000
