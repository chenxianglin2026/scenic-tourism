/* 首页样式 */
.page-container {
  padding-bottom: 20rpx;
  animation: fadeIn 0.5s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Banner */
.banner-swiper {
  width: 100%;
  height: 360rpx;
}

.banner-item {
  width: 100%;
  height: 100%;
  position: relative;
}

.banner-gradient {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(30,28,24,0.45) 0%, rgba(200,160,82,0.35) 50%, rgba(61,50,38,0.55) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.banner-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 4rpx 16rpx rgba(0,0,0,0.3);
}

.banner-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 12rpx;
  letter-spacing: 4rpx;
}

/* 自定义 swiper 指示器样式 */
.banner-swiper .wx-swiper-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin: 0 8rpx;
}

.banner-swiper .wx-swiper-dot-active {
  width: 28rpx;
  border-radius: 6rpx;
  background: #c8a052;
}

/* 景区卡片 */
.scenic-card {
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

.scenic-icon {
  font-size: 80rpx;
}

/* 快捷入口 */
.quick-section {
  padding: 30rpx;
}

.section-title {
  margin-bottom: 20rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 50, 38, 0.04);
}

.quick-icon {
  font-size: 56rpx;
  margin-bottom: 10rpx;
}

.quick-label {
  font-size: 24rpx;
  color: #3D3226;
  white-space: nowrap;
}

/* 公告 */
.notice-item {
  padding: 10rpx 0;
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c8a052;
  margin-right: 16rpx;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.notice-dot-red {
  background: #C56C6C;
}

/* 热门票种 */
.ticket-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.ticket-item {
  background: #FAF7F2;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  border: 2rpx solid #E8E0D5;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-state .text {
  font-size: 28rpx;
  color: #B0A492;
}
