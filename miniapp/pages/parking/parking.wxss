/* 停车缴费页 */
.page-container {
  padding-bottom: 20rpx;
  animation: fadeIn 0.5s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 停车场列表项 */
.lot-item {
  background: #FAF7F2;
  border: 2rpx solid #E8E0D5;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
  transition: all 0.2s;
}

.lot-item.selected {
  border-color: #c8a052;
  background: rgba(200, 160, 82, 0.06);
}

.lot-icon {
  font-size: 56rpx;
  width: 70rpx;
  text-align: center;
  flex-shrink: 0;
}

.lot-check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #c8a052;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 车牌输入 */
.plate-input-row {
  margin-bottom: 10rpx;
}

.plate-input {
  width: 100%;
  padding: 24rpx 20rpx;
  border: 2rpx solid #E8E0D5;
  border-radius: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  text-align: center;
  background: #FAF7F2;
  text-transform: uppercase;
}

/* 快捷省份 */
.plate-quick {
  /* placeholder */
}

.province-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.province-item {
  width: 64rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FAF7F2;
  border: 1rpx solid #E8E0D5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #3D3226;
}

.province-item:active {
  background: #c8a052;
  color: #fff;
  border-color: #c8a052;
}

/* 停车记录 */
.record-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0EBE0;
}

.record-item:last-child {
  border-bottom: none;
}

/* 停车中 - 计时显示 */
.active-icon {
  font-size: 120rpx;
}

.timer-display {
  text-align: center;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(200, 160, 82, 0.08), rgba(212, 184, 150, 0.12));
  border-radius: 16rpx;
}

.elapsed-text {
  font-size: 80rpx;
  font-weight: 700;
  color: #c8a052;
  font-family: 'Courier New', monospace;
  letter-spacing: 4rpx;
}

