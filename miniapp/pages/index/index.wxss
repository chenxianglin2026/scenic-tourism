/* 首页样式 */
.page-container {
  padding-bottom: 20rpx;
}

/* Banner */
.banner-swiper {
  width: 100%;
  height: 360rpx;
}

.banner-item {
  width: 100%;
  height: 100%;
}

/* 景区卡片 */
.scenic-card {
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

.scenic-icon {
  font-size: 80rpx;
}

/* 快捷入口 */
.quick-section {
  padding: 30rpx;
}

.section-title {
  margin-bottom: 20rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 50, 38, 0.04);
}

.quick-icon {
  font-size: 56rpx;
  margin-bottom: 10rpx;
}

.quick-label {
  font-size: 24rpx;
  color: #3D3226;
  white-space: nowrap;
}

/* 公告 */
.notice-item {
  padding: 10rpx 0;
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c8a052;
  margin-right: 16rpx;
  margin-top: 10rpx;
  flex-shrink: 0;
}

/* 热门票种 */
.ticket-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.ticket-item {
  background: #FAF7F2;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  border: 2rpx solid #E8E0D5;
}
