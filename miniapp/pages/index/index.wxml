<!--
  首页: 景区信息 + 快捷入口 + 公告 + 热门票种
  暖金色主题，适老化大字体
-->

<view class="page-container">

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="text">加载中...</view>
  </view>

  <!-- 顶部 Banner -->
  <block wx:if="{{!loading}}">
  <swiper class="banner-swiper" indicator-dots autoplay circular interval="4000" indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#c8a052">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="banner-item img-placeholder">
        <view class="banner-gradient">
          <view class="banner-text">{{item.title}}</view>
          <view class="banner-sub">{{item.subtitle || '欢迎来到景区智慧管理系统'}}</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 景区信息卡片 -->
  <view class="card scenic-card">
    <view class="flex-row">
      <view class="scenic-icon">🏞️</view>
      <view class="flex-1 ml-10">
        <view class="flex-row" style="align-items:baseline;">
          <view class="text-xl text-bold text-dark">{{scenic.name || '泰山风景名胜区'}}</view>
          <view class="tag tag-gold ml-10">5A景区</view>
        </view>
        <view class="flex-row mt-10" style="gap: 30rpx;">
          <text class="text-sm text-light">⭐ {{scenic.rating || '4.8'}} 分</text>
          <text class="text-sm text-light">🕐 {{scenic.openTime || '06:00-18:00'}}</text>
        </view>
        <view class="text-sm text-light mt-10">📍 {{scenic.address || '山东省泰安市'}}</view>
      </view>
    </view>
    <view class="flex-row mt-20" style="gap: 20rpx;">
      <view class="btn-primary flex-1" bindtap="onQuickEntry" data-type="scenic">
        景区详情
      </view>
      <view class="btn-outline flex-1" bindtap="onQuickEntry" data-type="tickets">
        立即购票
      </view>
    </view>
  </view>

  <!-- 快捷入口 4个: 购票/订房/导览/停车 -->
  <view class="quick-section">
    <view class="section-title text-lg text-bold text-dark">快捷服务</view>
    <view class="quick-grid">
      <view class="quick-item" bindtap="onQuickEntry" data-type="tickets">
        <view class="quick-icon">🎫</view>
        <view class="quick-label">景区购票</view>
      </view>
      <view class="quick-item" bindtap="onQuickEntry" data-type="hotels">
        <view class="quick-icon">🏨</view>
        <view class="quick-label">预订客房</view>
      </view>
      <view class="quick-item" bindtap="onQuickEntry" data-type="scenic">
        <view class="quick-icon">🗺️</view>
        <view class="quick-label">景区导览</view>
      </view>
      <view class="quick-item" bindtap="onQuickEntry" data-type="parking">
        <view class="quick-icon">🅿️</view>
        <view class="quick-label">停车缴费</view>
      </view>
    </view>
  </view>

  <!-- 公告 -->
  <view class="card">
    <view class="flex-between mb-20">
      <view class="text-lg text-bold text-dark">📢 景区公告</view>
    </view>
    <view wx:if="{{notices.length === 0}}" class="empty-state" style="padding: 40rpx 0;">
      <view class="text">暂无公告</view>
    </view>
    <view wx:for="{{notices}}" wx:key="id" class="notice-item" bindtap="onNoticeTap" data-id="{{item.id}}">
      <view class="flex-row">
        <view class="notice-dot {{item.category === 'emergency' ? 'notice-dot-red' : ''}}"></view>
        <view class="flex-1">
          <view class="text-dark text-bold">{{item.title}}</view>
          <view class="text-sm text-light mt-10">{{item.time}}</view>
        </view>
      </view>
      <view wx:if="{{index < notices.length - 1}}" class="divider"></view>
    </view>
  </view>

  <!-- 套餐快购（五大购票升级 #2） -->
  <view wx:if="{{quickBuyPackages.length > 0}}" class="card mb-30">
    <view class="flex-between mb-20">
      <view class="text-lg text-bold text-dark">📦 套餐快购</view>
      <view class="text-sm text-primary" bindtap="onQuickEntry" data-type="tickets">更多 ></view>
    </view>
    <view class="ticket-grid">
      <view wx:for="{{quickBuyPackages}}" wx:key="id" class="ticket-item" bindtap="onQuickEntry" data-type="tickets">
        <view class="text-bold text-dark">{{item.name}}</view>
        <view class="mt-10">
          <text class="price-symbol">¥</text>
          <text class="price-value">{{item.price}}</text>
          <text class="price-unit">起</text>
          <text wx:if="{{item.original_price}}" class="text-sm text-light" style="text-decoration:line-through;margin-left:8rpx;">¥{{item.original_price}}</text>
        </view>
        <view class="text-sm text-primary mt-10">{{item.tags.join(' · ')}}</view>
      </view>
    </view>
  </view>

  <!-- 热门票种 -->
  <view class="card mb-30">
    <view class="flex-between mb-20">
      <view class="text-lg text-bold text-dark">🎫 热门票种</view>
      <view class="text-sm text-primary" bindtap="onQuickEntry" data-type="tickets">更多 ></view>
    </view>
    <view wx:if="{{tickets.length === 0}}" class="empty-state" style="padding: 40rpx 0;">
      <view class="text">暂无票种</view>
    </view>
    <view wx:else class="ticket-grid">
      <view wx:for="{{tickets}}" wx:key="id" class="ticket-item" bindtap="onBuyTicket" data-id="{{item.id}}">
        <view class="text-bold text-dark">{{item.name}}</view>
        <view class="mt-10">
          <text class="price-symbol">¥</text>
          <text class="price-value">{{item.price}}</text>
          <text class="price-unit">起</text>
        </view>
        <view class="text-sm text-light mt-10">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 安全区域 -->
  <view class="safe-bottom" style="height: 40rpx;"></view>

  </block>

</view>
